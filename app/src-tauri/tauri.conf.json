{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arogya Swasthya",
  "version": "0.1.0",
  "identifier": "dev.arogya.swasthya",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arogya Swasthya",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src blob:; frame-src blob:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRUMzOUNFQTNDOTU3RUQKUldUdFY4bWp6am5zM0d3NkI2M2lyc0NHVFlzSlJJcWQ5OU45WHFTeFJjdUtyWWwvcEtJdGRtcHEK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/sudharamachandranrajeev/arogya-swasthya/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
